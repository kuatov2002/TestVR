    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u041A\u043D\u043E\u043F\u043A\u0438
    \u0438 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C
    \u0441\u043F\u0440\u0430\u0432\u0430 \u2014 \u043C\u044B\u0448\u044C\u044E.\n\u0426\u0432\u0435\u0442\u043D\u044B\u0435
    \u0437\u043E\u043D\u044B \u2014 \u0432\u0441\u0442\u0430\u0442\u044C \u043D\u0430
    \u043D\u0438\u0445; \u044F\u0449\u0438\u043A\u0438 \u0438 \u043A\u043E\u043B\u043E\u043A\u043E\u043B
    \u2014 \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E."
